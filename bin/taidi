def get_desktop_metadata():
    """Reads .desktop files to resolve titles and icons."""
    meta = {}
    search_dirs = [
        Path("/usr/share/applications"),
        HOME / ".local" / "share" / "applications",
    ]
    for d in search_dirs:
        if not d.exists():
            continue
        for p in sorted(d.glob("*.desktop")):
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(p, encoding="utf-8")
                title = cp.get("Desktop Entry", "Name", fallback=p.stem)
                icon = cp.get("Desktop Entry", "Icon", fallback="")
                meta[p.name] = {"title": title, "icon": icon, "path": str(p)}
            except Exception:
                meta[p.name] = {"title": p.stem, "icon": "", "path": str(p)}
    return meta


def load_menu():
    """
    Parses ~/.config/lipstick/applications.menu directly as the SINGLE SOURCE OF TRUTH.
    Returns:
      root_apps: list of str (desktop filenames)
      folders: list of dict {"id": str, "title": str, "icon": str, "dir_file": Path, "apps": list}
    """
    if not APPLICATIONS_MENU.exists():
        if BACKUP_MENU.exists():
            menu_path = BACKUP_MENU
        else:
            return [], []
    else:
        menu_path = APPLICATIONS_MENU

    tree = ET.parse(menu_path)
    root = tree.getroot()

    root_apps = []
    folders = []
    seen = set()
    folder_idx = 1

    for child in root:
        if child.tag == "Filename" and child.text:
            fn = child.text.strip()
            if fn and fn not in seen:
                root_apps.append(fn)
                seen.add(fn)
        elif child.tag == "Menu":
            title_el = child.find("Name")
            dir_el = child.find("Directory")
            title = title_el.text.strip() if (title_el is not None and title_el.text) else f"Folder {folder_idx}"
            dir_str = dir_el.text.strip() if (dir_el is not None and dir_el.text) else ""

            icon = "icon-launcher-folder-01"
            folder_id = f"Folder_{folder_idx:02d}"
            dir_file = None

            if dir_str:
                dp = Path(dir_str)
                if not dp.is_absolute():
                    dp = LIPSTICK_CONFIG_DIR / dp
                folder_id = dp.stem
                dir_file = dp
                if dp.exists():
                    cp = configparser.ConfigParser(interpolation=None, strict=False)
                    try:
                        cp.read(dp, encoding="utf-8")
                        icon = cp.get("Desktop Entry", "Icon", fallback=icon)
                    except Exception:
                        pass
            else:
                dir_file = LIPSTICK_CONFIG_DIR / f"{folder_id}.directory"

            f_apps = []
            for fn_el in child.findall("Filename"):
                if fn_el.text and fn_el.text.strip():
                    fn = fn_el.text.strip()
                    if fn not in seen:
                        f_apps.append(fn)
                        seen.add(fn)

            folders.append({
                "id": folder_id,
                "title": title,
                "icon": icon,
                "dir_file": dir_file,
                "apps": f_apps,
            })
            folder_idx += 1

    return root_apps, folders


def save_menu(root_apps, folders):
    """
    Atomically writes ~/.config/lipstick/applications.menu using tempfile + os.replace.
    Also ensures directory files exist and exports an informational folders.json.
    """
    LIPSTICK_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TAIDI_DIR.mkdir(parents=True, exist_ok=True)

    # 1. Ensure .directory files are up-to-date
    for idx, f in enumerate(folders, start=1):
        folder_id = re.sub(r"[^A-Za-z0-9_-]", "_", f.get("id") or f"Folder_{idx:02d}")
        title = f.get("title") or f"Folder {idx}"
        icon = f.get("icon") or "icon-launcher-folder-01"
        dir_file = LIPSTICK_CONFIG_DIR / f"{folder_id}.directory"
        f["dir_file"] = dir_file
        dir_content = f"[Desktop Entry]\nType=Directory\nName={title}\nIcon={icon}\n"
        dir_file.write_text(dir_content, encoding="utf-8")

    # 2. Build XML
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        "<Menu>",
        "    <Name>",
        "    </Name>",
    ]

    for fn in root_apps:
        lines.append(f"    <Filename>{_xml_escape(fn)}</Filename>")

    for f in folders:
        title = f.get("title", "")
        dir_file = f.get("dir_file")
        lines.append("    <Menu>")
        lines.append(f"        <Name>{_xml_escape(title)}</Name>")
        lines.append(f"        <Directory>{_xml_escape(str(dir_file))}</Directory>")
        for fn in f.get("apps", []):
            lines.append(f"        <Filename>{_xml_escape(fn)}</Filename>")
        lines.append("    </Menu>")

    lines.append("</Menu>")
    xml_content = "\n".join(lines) + "\n"

    # Verify XML parse before writing to disk
    ET.fromstring(xml_content)

    # Atomic write to applications.menu
    tmp_path = LIPSTICK_CONFIG_DIR / "applications.menu.taidi_tmp"
    tmp_path.write_text(xml_content, encoding="utf-8")
    os.replace(tmp_path, APPLICATIONS_MENU)

    # Informational JSON export
    state = {
        "root_apps": root_apps,
        "folders": [
            {"id": f["id"], "title": f["title"], "icon": f["icon"], "apps": f["apps"]}
            for f in folders
        ]
    }
    EXPORT_JSON.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def _xml_escape(val: str) -> str:
    return (
        val.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def verify_integrity(root_apps, folders):
    """Checks for duplicate or missing applications."""
    all_current = list(root_apps)
    for f in folders:
        all_current.extend(f["apps"])

    # Expected list from original menu if available
    expected = []
    source = BACKUP_MENU if BACKUP_MENU.exists() else APPLICATIONS_MENU
    if source.exists():
        tree = ET.parse(source)
        for el in tree.getroot().iter("Filename"):
            if el.text and el.text.strip():
                fn = el.text.strip()
                if fn not in expected:
                    expected.append(fn)

    duplicates = [x for x in set(all_current) if all_current.count(x) > 1]
    missing = [x for x in expected if x not in all_current]

    return {
        "ok": len(duplicates) == 0 and len(missing) == 0,
        "total_current": len(all_current),
        "total_expected": len(expected) if expected else len(all_current),
        "duplicates": duplicates,
        "missing": missing,
    }


def resolve_app(query: str, all_apps: list, meta: dict):
    if query in all_apps:
        return query
    if f"{query}.desktop" in all_apps:
        return f"{query}.desktop"
    q_low = query.lower()
    for fn in all_apps:
        title = meta.get(fn, {}).get("title", "").lower()
        if q_low == title or q_low in fn.lower() or q_low in title:
            return fn
    return None


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    meta = get_desktop_metadata()
    root_apps, folders = load_menu()

    all_apps = list(root_apps)
    for f in folders:
        all_apps.extend(f["apps"])

    if cmd in ("init-default", "reset-default"):
        assigned = set()
        new_root = []
        for fn in DEFAULT_PINNED_ROOT:
            if fn in all_apps and fn not in assigned:
                new_root.append(fn)
                assigned.add(fn)

        new_folders = []
        for fdef in DEFAULT_FOLDERS:
            f_apps = []
            for fn in fdef["apps"]:
                if fn in all_apps and fn not in assigned:
                    f_apps.append(fn)
                    assigned.add(fn)
            new_folders.append({
                "id": fdef["id"],
                "title": fdef["title"],
                "icon": fdef["icon"],
                "apps": f_apps,
            })

        for fn in all_apps:
            if fn not in assigned:
                new_root.append(fn)
                assigned.add(fn)

        save_menu(new_root, new_folders)
        res = verify_integrity(new_root, new_folders)
        print(f"Applied default layout: {len(new_root)} root apps, {len(new_folders)} folders.")
        print(f"Integrity check: {json.dumps(res)}")
        return

    if cmd == "create-folder":
        if len(sys.argv) < 3:
            print("Usage: taidi create-folder <Title> [icon_id]")
            sys.exit(1)
        title = sys.argv[2]
        icon = sys.argv[3] if len(sys.argv) > 3 else "icon-launcher-folder-01"
        for f in folders:
            if f["title"].lower() == title.lower():
                f["icon"] = icon
                save_menu(root_apps, folders)
                print(f"Updated icon for folder '{title}'.")
                return

        next_idx = len(folders) + 1
        used_ids = {f["id"] for f in folders}
        while f"Folder_{next_idx:02d}" in used_ids:
            next_idx += 1
        folders.append({
            "id": f"Folder_{next_idx:02d}",
            "title": title,
            "icon": icon,
            "apps": [],
        })
        save_menu(root_apps, folders)
        print(f"Created folder '{title}' ({icon}).")
        return

    if cmd == "rename-folder":
        if len(sys.argv) < 4:
            print("Usage: taidi rename-folder <OldTitle> <NewTitle>")
            sys.exit(1)
        old_t, new_t = sys.argv[2], sys.argv[3]
        for f in folders:
            if f["title"].lower() == old_t.lower() or f["id"].lower() == old_t.lower():
                f["title"] = new_t
                save_menu(root_apps, folders)
                print(f"Renamed folder '{old_t}' -> '{new_t}'.")
                return
        print(f"Folder '{old_t}' not found.")
        sys.exit(1)

    if cmd == "delete-folder":
        if len(sys.argv) < 3:
            print("Usage: taidi delete-folder <Title>")
            sys.exit(1)
        target = sys.argv[2].lower()
        kept = []
        removed = None
        for f in folders:
            if f["title"].lower() == target or f["id"].lower() == target:
                removed = f
                for fn in f["apps"]:
                    if fn not in root_apps:
                        root_apps.append(fn)
            else:
                kept.append(f)
        if not removed:
            print(f"Folder '{sys.argv[2]}' not found.")
            sys.exit(1)
        save_menu(root_apps, kept)
        print(f"Deleted folder '{removed['title']}' and returned {len(removed['apps'])} apps to main grid.")
        return

    if cmd in ("move", "move-app"):
        if len(sys.argv) < 4:
            print("Usage: taidi move <AppNameOrDesktop> <FolderTitleOrRoot>")
            sys.exit(1)
        app_query, target_folder = sys.argv[2], sys.argv[3]
        fn = resolve_app(app_query, all_apps, meta)
        if not fn:
            print(f"App matching '{app_query}' not found.")
            sys.exit(1)

        # Remove from existing location
        if fn in root_apps:
            root_apps.remove(fn)
        for f in folders:
            if fn in f["apps"]:
                f["apps"].remove(fn)

        if target_folder.lower() in ("root", "main", "/"):
            root_apps.append(fn)
            save_menu(root_apps, folders)
            print(f"Moved '{fn}' to main grid.")
            return

        for f in folders:
            if f["title"].lower() == target_folder.lower() or f["id"].lower() == target_folder.lower():
                f["apps"].append(fn)
                save_menu(root_apps, folders)
                print(f"Moved '{fn}' -> folder '{f['title']}'.")
                return

        # Auto-create if not found
        next_idx = len(folders) + 1
        used_ids = {f["id"] for f in folders}
        while f"Folder_{next_idx:02d}" in used_ids:
            next_idx += 1
        folders.append({
            "id": f"Folder_{next_idx:02d}",
            "title": target_folder,
            "icon": "icon-launcher-folder-01",
            "apps": [fn],
        })
        save_menu(root_apps, folders)
        print(f"Created folder '{target_folder}' and moved '{fn}' into it.")
        return

    # Default: status
    res = verify_integrity(root_apps, folders)
    print("=== TAIDI Launcher Status ===")
    print(f"Main grid apps ({len(root_apps)}):")
    for fn in root_apps:
        print(f"  - {meta.get(fn, {}).get('title', fn)} ({fn})")
    print(f"\nFolders ({len(folders)}):")
    for f in folders:
        titles = [meta.get(fn, {}).get("title", fn) for fn in f["apps"]]
        print(f"  [{f['id']}] {f['title']} ({f['icon']}) - {len(f['apps'])} apps: {', '.join(titles)}")
    print(f"\nIntegrity: {json.dumps(res)}")


if __name__ == "__main__":
    main()
