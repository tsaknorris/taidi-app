#!/usr/bin/env python3
"""
Taidi CLI - Sailfish OS Launcher Grid & Folder Organizer.

Single source of truth: ~/.config/lipstick/applications.menu
Atomic writes: uses temporary file + os.replace() to prevent corruption.
Zero proprietary dependencies: purely manipulates standard freedesktop / lipstick menu XML.
"""

