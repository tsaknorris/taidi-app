#!/usr/bin/env python3
"""
Jolla 2026 (Sailfish OS) Home-Directory Folder & Launcher Grid Manager.
Manages ~/.config/lipstick/applications.menu, ~/.config/lipstick/Folder_*.directory,
and ~/.local/share/jolla-folders/folders.json (mirrored to ~/.local/share/tietix-folders/folders.json).
"""

